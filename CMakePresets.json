{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "local-llvm",
      "displayName": "Repository-local LLVM (C++20 Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/local-llvm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      },
      "toolchainFile": "${sourceDir}/cmake/macos-local-llvm.cmake"
    },
    {
      "name": "local-llvm-sanitize",
      "inherits": "local-llvm",
      "binaryDir": "${sourceDir}/build/local-llvm-sanitize",
      "cacheVariables": {
        "ORDER_BOOK_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-llvm",
      "configurePreset": "local-llvm"
    },
    {
      "name": "local-llvm-sanitize",
      "configurePreset": "local-llvm-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "local-llvm",
      "configurePreset": "local-llvm",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "local-llvm-sanitize",
      "configurePreset": "local-llvm-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
